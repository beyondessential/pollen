// The onboarding ruleset. Authored here, in RON; the engine evaluates it
// (spec WIZ). This file is the single source of truth for the concrete
// questions and consequences; comments capture the rationale. It is normalized
// to canonical JSON and content-addressed by hash, so comments and formatting
// don't affect identity.
//
// There is one canonical ruleset, here. Variant or proposed rulesets live on
// git branches of this same file (previewed via ?config=<branch>), not as
// parallel versioned files. Its identity is its content hash, never a label.
//
// Stable-id discipline (spec WIZ): every question and option `id` is permanent.
// Never reuse or repurpose an id; add new ones instead.
//
// The flow is ordered so a non-technical reader can stop early and still get a
// useful estimate: the three sizing questions come first and are the only ones
// that must be answered, then intent, then hosting, then the technical section
// (collapsed on arrival). Every question past the essentials either declares a
// blessed-path `default` the engine assumes when it is left blank, or offers an
// `unsure` option that records it as an open item on an interim artifact.
//
// Many on-prem rules repeat the same "any client-hosted presence" or "any BES
// cloud present" condition. There are no variables in the data, so the
// conditions are spelled out at each use.

(
    sections: [
        (id: "essentials", label: "Your health system"),
        (id: "intent", label: "What you want Tamanu to do"),
        (id: "hosting", label: "Where it runs"),
        (id: "advanced", label: "Answer more for a more accurate plan", collapsed: true),
    ],

    questions: [
        // ── Essentials ──────────────────────────────────────────────────────
        // The sizing bands. These have no blessed default, because there is no typical
        // catchment population, so catchment and facilities are the only
        // questions that must be answered. Mobile can be declined because size
        // still derives from the other two.
        (
            id: "catchment",
            kind: Band,
            section: Some("essentials"),
            label: "How many people does the health system serve?",
            options: [
                (id: "c0", label: "Under 1,000"),
                (id: "c1", label: "1,000 - 10,000"),
                (id: "c2", label: "10,000 - 100,000"),
                (id: "c3", label: "Over 100,000"),
            ],
        ),
        (
            id: "facilities",
            kind: Band,
            section: Some("essentials"),
            label: "How many facilities will use Tamanu?",
            help: Some("Hospitals, clinics, and health posts."),
            options: [
                (id: "f0", label: "One"),
                (id: "f1", label: "2 - 5"),
                (id: "f2", label: "6 - 20"),
                (id: "f3", label: "More than 20"),
            ],
        ),
        (
            id: "mobile",
            kind: Band,
            section: Some("essentials"),
            label: "How many people will use Tamanu on a phone or tablet?",
            help: Some("Community health workers, and anyone working away from a desk."),
            options: [
                (id: "m0", label: "None"),
                (id: "m1", label: "1 - 10"),
                (id: "m2", label: "10 - 50"),
                (id: "m3", label: "More than 50"),
                (id: "m_unsure", label: "I'm not sure", unsure: true),
            ],
        ),

        // ── Intent ──────────────────────────────────────────────────────────
        // Tupaia is a capability worth having by default, so it is presented as
        // what it gives you and defaults to on. Asked before backups because it
        // constrains them.
        (
            id: "tupaia",
            kind: Single,
            section: Some("intent"),
            label: "Do you want dashboards and reporting?",
            help: Some("Provided by [Tupaia](https://tupaia.org). BES processes the data to do this, so it needs at least a short-retention backup."),
            default: Some("yes"),
            options: [
                (id: "yes", label: "Yes, include dashboards and reporting", note: Some("Programme monitoring and routine indicators.")),
                (id: "no", label: "No, Tamanu only"),
                (id: "unsure", label: "I'm not sure", unsure: true),
            ],
        ),
        (
            id: "integrations",
            kind: Multi,
            section: Some("intent"),
            label: "Does Tamanu need to connect to other systems?",
            options: [
                (id: "lims", label: "Laboratory system", note: Some("SENAITE or another LIMS.")),
                (id: "msupply", label: "Pharmacy or warehousing", note: Some("mSupply or another stock system.")),
                (id: "rispacs", label: "Imaging", note: Some("RIS / PACS.")),
                (id: "other_fhir", label: "Something else that speaks FHIR"),
                (id: "other_nonfhir", label: "Something else, not FHIR-based"),
                (id: "none", label: "No integrations", exclusive: true),
                (id: "unsure", label: "I'm not sure", exclusive: true, unsure: true),
            ],
        ),
        (
            id: "hosted_integration",
            kind: Single,
            section: Some("intent"),
            label: "Who runs those other systems?",
            help: Some("BES hosting them is possible, but is scoped in a separate conversation."),
            default: Some("no"),
            options: [
                (id: "no", label: "The client runs them"),
                (id: "yes", label: "BES should host them"),
            ],
            // Only when at least one connection is wanted.
            visible_if: Any([
                Includes("integrations", "lims"),
                Includes("integrations", "msupply"),
                Includes("integrations", "rispacs"),
                Includes("integrations", "other_fhir"),
                Includes("integrations", "other_nonfhir"),
            ]),
        ),

        // ── Hosting ─────────────────────────────────────────────────────────
        // Central first: where the hub lives frames the facility split that
        // follows.
        (
            id: "central",
            kind: Single,
            section: Some("hosting"),
            label: "Where should the central server run?",
            help: Some("The central server ties the facilities together. Normally BES cloud, even when facilities run on site."),
            default: Some("bescloud"),
            options: [
                (id: "bescloud", label: "BES cloud", note: Some("Recommended. Fully managed; the client still gets full application access.")),
                (id: "clienthosted", label: "Client hosted", warn: Some("Hosting the central server yourself means your IT team carries availability, backups, and upgrades for it, and BES incident response is slower.")),
            ],
        ),
        // Planning grain (spec WIZ): the tool records which classes are present
        // and a rough balance between them, never a facility-by-facility map.
        // Client cloud and true on-prem behaved identically in every rule, so
        // they are one option here; how those servers are provisioned is asked
        // further down, where it actually differs.
        //
        // Most deployments are all one or all the other, so the balance is a
        // follow-up rather than something everyone has to set.
        (
            id: "hosting_where",
            kind: Single,
            section: Some("hosting"),
            label: "Where should the facility servers run?",
            default: Some("allclient"),
            options: [
                (id: "allbes", label: "All in BES cloud", note: Some("Hosted by BES in a secure AWS data centre.")),
                (id: "allclient", label: "All client hosted", note: Some("On servers the client owns or rents. Keeps working when the internet link is down.")),
                (id: "mix", label: "A mix of both"),
            ],
        ),
        (
            id: "hosting_balance",
            kind: Band,
            section: Some("hosting"),
            label: "Roughly what balance?",
            default: Some("half"),
            options: [
                (id: "mostlybes", label: "Mostly BES cloud"),
                (id: "half", label: "About half"),
                (id: "mostlyclient", label: "Mostly client hosted"),
            ],
            visible_if: Equals("hosting_where", "mix"),
        ),
        // Tamanu Iti is a way of running a facility site, not a place, so it is
        // asked separately once something sits outside BES cloud. Sites running
        // Iti have no operating system or provisioning to choose.
        (
            id: "iti_use",
            kind: Single,
            section: Some("hosting"),
            label: "Will any of those sites use a Tamanu Iti mini-server?",
            help: Some("A mini-server, built by BES, that plugs into the facility network."),
            default: Some("none"),
            options: [
                (id: "none", label: "No, they run their own servers"),
                (id: "some", label: "Yes, some of them"),
                (id: "all", label: "Yes, all of them"),
            ],
            visible_if: Any([
                Equals("hosting_where", "allclient"),
                Equals("hosting_where", "mix"),
            ]),
        ),
        // ── Technical details ───────────────────────────────────────────────
        // Every question below declares a blessed-path default, so a user who
        // never opens this section still gets a complete, supported estimate.
        // Each also offers a way to decline where the answer is a policy call
        // the client may not have made yet.
        (
            id: "onprem_form",
            kind: Single,
            section: Some("advanced"),
            label: "How are the client-hosted servers provided?",
            help: Some("The two are provisioned differently, so the requirements differ."),
            default: Some("virtualised"),
            options: [
                (id: "virtualised", label: "Virtual machines"),
                (id: "baremetal", label: "Physical servers"),
                (id: "mixed", label: "Both"),
            ],
            visible_if: Any([
                Equals("central", "clienthosted"),
                All([
                    Any([
                        Equals("hosting_where", "allclient"),
                        Equals("hosting_where", "mix"),
                    ]),
                    Not(Equals("iti_use", "all")),
                ]),
            ]),
        ),
        (
            id: "region",
            kind: Single,
            section: Some("advanced"),
            label: "Which hosting region?",
            default: Some("sydney"),
            options: [
                (id: "sydney", label: "Sydney", note: Some("Standard.")),
                (id: "otheraws", label: "Another AWS region", warn: Some("Supported, but adds ongoing cost. The actual figures are confirmed separately.")),
            ],
            visible_if: Any([
                Equals("central", "bescloud"),
                Equals("hosting_where", "allbes"),
                Equals("hosting_where", "mix"),
            ]),
        ),
        // Only when a client-hosted server has an OS to choose. BES cloud and
        // the Tamanu Iti mini-server are fixed to Linux on ARM64.
        (
            id: "platform",
            kind: Single,
            section: Some("advanced"),
            label: "Operating system for the client-hosted servers",
            help: Some("BES cloud and Tamanu Iti are fixed to Linux on ARM64."),
            default: Some("linuxarm"),
            options: [
                (id: "linuxarm", label: "Linux on ARM64", note: Some("Required for full support.")),
                (id: "linuxamd", label: "Linux on AMD64", warn: Some("ARM64 is the supported platform. AMD64 works, but carries a higher ongoing support and hosting cost.")),
                (id: "windows", label: "Windows Server", warn: Some("Being phased out, and accepted only on strong insistence. The client licenses Windows, the application runs slower, and support and incident response are slower and less effective.")),
            ],
            visible_if: Any([
                Equals("central", "clienthosted"),
                All([
                    Any([
                        Equals("hosting_where", "allclient"),
                        Equals("hosting_where", "mix"),
                    ]),
                    Not(Equals("iti_use", "all")),
                ]),
            ]),
        ),

        // Backups, DNS and telemetry are client policy calls rather than
        // technical preferences, so they offer "I'm not sure" and are never
        // assumed: a wrong guess here would materially misstate the estimate.
        (
            id: "backup_capability",
            kind: Single,
            section: Some("advanced"),
            label: "Can BES take backups of the data?",
            help: Some("Separate from how long they are kept. Upgrade testing needs only a one-off backup."),
            default: Some("yes"),
            options: [
                (id: "yes", label: "Yes, BES may take backups"),
                (id: "no", label: "No, BES may not take backups", warn: Some("This removes BES-managed recovery, dashboards and reporting, and upgrade testing against a copy of the data.")),
                (id: "unsure", label: "I'm not sure", unsure: true),
            ],
        ),
        (
            id: "retention",
            kind: Single,
            section: Some("advanced"),
            label: "How long should BES keep backups?",
            default: Some("full"),
            options: [
                (id: "full", label: "Full retention", note: Some("The latest backup, a week of daily, a month of weekly, and six monthly.")),
                (id: "low", label: "A few days only", note: Some("Long enough to feed dashboards and run upgrade tests."), warn: Some("Anything that goes wrong unnoticed for longer than a few days cannot be recovered, because there is no earlier backup to go back to.")),
            ],
            visible_if: Equals("backup_capability", "yes"),
        ),
        (
            id: "cadence",
            kind: Single,
            section: Some("advanced"),
            label: "How often do you intend to upgrade?",
            help: Some("Tamanu releases a new version every two weeks. You don't need to upgrade with every release, most deployments skip a few and upgrade around once every two months."),
            default: Some("twomonths"),
            options: [
                (id: "release", label: "Every release", note: Some("Roughly fortnightly.")),
                (id: "twomonths", label: "Every two months"),
                (id: "lessoften", label: "Less often", warn: Some("BES supports the last 10 releases. We recommend updating at minimum every three months, to avoid ending up on an unsupported version of Tamanu.")),
            ],
        ),
        (
            id: "dns",
            kind: Single,
            section: Some("advanced"),
            label: "Who should manage the web addresses and certificates?",
            help: Some("Tamanu needs domain names and TLS certificates."),
            default: Some("bes"),
            options: [
                (id: "bes", label: "BES manages them", note: Some("Recommended. Nothing for client IT to run.")),
                (id: "client", label: "The client's IT team manages them", warn: Some("The client must support automatic ACME certificate issuance, and keep every deployment domain under a common stem.")),
                (id: "local", label: "No web addresses, local network only", warn: Some("Servers reach each other over plain HTTP: no certificates, no encryption in transit. Supported, but an operational and security risk.")),
                (id: "unsure", label: "I'm not sure", unsure: true),
            ],
        ),
        (
            id: "dns_arrangement",
            kind: Single,
            section: Some("advanced"),
            label: "Which domain should be used?",
            default: Some("bes_subdomain"),
            options: [
                (id: "bes_subdomain", label: "A name on tamanu.app", note: Some("Recommended. For example vanuatu.tamanu.app.")),
                (id: "bes_topdomain", label: "A dedicated domain BES owns", warn: Some("BES registers and runs a dedicated domain, which carries a small ongoing cost.")),
                (id: "client_domain", label: "A domain the client buys, pointed at BES", warn: Some("The client purchases the domain and client IT points it at a BES-provisioned DNS zone.")),
                (id: "client_subdomain", label: "A subdomain the client delegates to BES", warn: Some("Client IT allocates a subdomain and delegates it to BES with SOA records, a setup step on the client side.")),
            ],
            visible_if: Equals("dns", "bes"),
        ),
        (
            id: "remote",
            kind: Single,
            section: Some("advanced"),
            label: "How does BES reach the servers it manages?",
            default: Some("tailscale"),
            options: [
                (id: "tailscale", label: "Tailscale", note: Some("Required. Only the managed servers need it allowed, not the whole network.")),
                (id: "other", label: "Some other arrangement", warn: Some("Tailscale is what BES supports. Anything else is exceptional and may add significant ongoing cost.")),
            ],
        ),
        (
            id: "timesync",
            kind: Single,
            section: Some("advanced"),
            label: "How do the servers keep accurate time?",
            help: Some("Clock drift breaks Tamanu."),
            default: Some("outbound"),
            options: [
                (id: "outbound", label: "Public time servers", note: Some("Allow outbound traffic to pool.ntp.org.")),
                (id: "internal", label: "An internal time server", note: Some("The client provides the IP.")),
            ],
        ),
        (
            id: "telemetry",
            kind: Single,
            section: Some("advanced"),
            label: "Can the servers send operational telemetry to BES?",
            help: Some("Operational data only, never patient, clinical, or sensitive data. It is what lets BES support the deployment, back it up, and keep mobile working."),
            default: Some("yes"),
            options: [
                (id: "yes", label: "Yes, allow telemetry"),
                (id: "no", label: "No telemetry", warn: Some("This opts the deployment out of BES tech support, managed backups, and mobile support.")),
                (id: "unsure", label: "I'm not sure", unsure: true),
            ],
        ),
    ],

    // Size = the highest band reached across the three sizing questions, mapped
    // by ordinal. All three have four bands; the lowest maps to Tiny, then Small,
    // Medium, Large. An "I'm not sure" band contributes nothing.
    derivations: [
        (
            id: "size",
            kind: HighestBand(
                questions: ["catchment", "facilities", "mobile"],
                labels: ["Tiny", "Small", "Medium", "Large"],
                // Any connected system bumps the deployment up one size (capped).
                bump_when: Some(Any([
                    Includes("integrations", "lims"),
                    Includes("integrations", "msupply"),
                    Includes("integrations", "rispacs"),
                    Includes("integrations", "other_fhir"),
                    Includes("integrations", "other_nonfhir"),
                ])),
            ),
        ),
    ],

    // Forward guidance shown before a constraint is reached.
    guidance: [
        (
            at: "backup_capability",
            when: Equals("tupaia", "yes"),
            message: "You asked for dashboards and reporting, so backups can't be fully disabled. At minimum, a few days of retention is needed.",
        ),
    ],

    rules: [
        // ── Intent ──────────────────────────────────────────────────────────
        (
            id: "tupaia-on",
            source: "intent",
            when: Equals("tupaia", "yes"),
            consequence: (
                status: Requirement,
                audience: Bes,
                title: "Set up the Tupaia connection",
                detail: "Connecting to Tupaia means BES processes the data, which requires at minimum a low-retention backup.",
            ),
        ),
        (
            id: "int-capacity",
            source: "intent",
            when: Any([
                Includes("integrations", "lims"),
                Includes("integrations", "msupply"),
                Includes("integrations", "rispacs"),
                Includes("integrations", "other_fhir"),
                Includes("integrations", "other_nonfhir"),
            ]),
            consequence: (
                status: Advisory,
                audience: Bes,
                types: [Operational],
                title: "Size Central up for the connected systems",
                detail: "Any integrations add load to the central server, so Central is provisioned with more resources. This is a flat allowance; the number of integrations does not change it.",
            ),
        ),
        (
            id: "int-hosted",
            source: "intent",
            when: Equals("hosted_integration", "yes"),
            consequence: (
                status: Referral,
                audience: Bes,
                title: "Scope the BES-hosted integration separately",
                detail: "Hosting an integration on BES infrastructure is possible but is scoped in a dedicated technical conversation. This record only flags the intent.",
            ),
        ),
        (
            id: "int-nonfhir-cost",
            source: "intent",
            when: Includes("integrations", "other_nonfhir"),
            consequence: (
                severity: NonDefault,
                status: Advisory,
                audience: Record,
                types: [Cost],
                title: "A system with no standard interface needs custom development",
                detail: "A non-FHIR integration has no standard interface, so connecting it requires bespoke development. It is supported with no other blockers, but adds significant one-off development cost.",
            ),
        ),

        // ── Region ──────────────────────────────────────────────────────────
        // Where the BES cloud hosting sits is a setup decision BES acts on, so
        // it appears as their work rather than as a header fact. Leaving the
        // standard region is separately an acknowledgement.
        (
            id: "region-sydney",
            source: "region",
            when: All([
                Any([
                    Equals("central", "bescloud"),
                    Equals("hosting_where", "allbes"),
                    Equals("hosting_where", "mix"),
                ]),
                Equals("region", "sydney"),
            ]),
            consequence: (
                status: Requirement,
                audience: Bes,
                title: "Provision the BES cloud hosting in Sydney",
                detail: "The standard region. Nothing to price beyond the usual hosting.",
            ),
        ),
        (
            id: "region-other-setup",
            source: "region",
            when: All([
                Any([
                    Equals("central", "bescloud"),
                    Equals("hosting_where", "allbes"),
                    Equals("hosting_where", "mix"),
                ]),
                Equals("region", "otheraws"),
            ]),
            consequence: (
                status: Requirement,
                audience: Pricing,
                types: [Cost],
                title: "Price the non-standard hosting region",
                detail: "Hosting outside Sydney needs the region settled and its ongoing cost worked out before setup.",
            ),
        ),
        (
            id: "region-other",
            source: "region",
            when: All([
                Any([
                    Equals("central", "bescloud"),
                    Equals("hosting_where", "allbes"),
                    Equals("hosting_where", "mix"),
                ]),
                Equals("region", "otheraws"),
            ]),
            consequence: (
                severity: NonDefault,
                status: Advisory,
                audience: Record,
                types: [Cost],
                title: "Hosting outside the standard Sydney region",
                detail: "Running outside the standard Sydney region is supported but adds ongoing cost. The actual figures are confirmed separately, not here.",
            ),
        ),

        // ── Platform ────────────────────────────────────────────────────────
        // ARM64 is the supported platform; everything else carries a penalty,
        // graded from added cost through to unsupported.
        (
            id: "plat-amd64",
            source: "platform",
            when: Equals("platform", "linuxamd"),
            consequence: (
                severity: NonDefault,
                status: Advisory,
                audience: Record,
                types: [Cost, Support],
                title: "AMD64 instead of the standard ARM64",
                detail: "Linux on ARM64 is the platform BES builds, tests, and supports first. AMD64 is supported, but hosting costs more per unit of capacity and upgrades get less pre-release testing on it, so incidents take longer to resolve.",
            ),
        ),
        (
            id: "plat-windows-licence",
            source: "platform",
            when: Equals("platform", "windows"),
            consequence: (
                status: Requirement,
                audience: Client,
                types: [Cost],
                title: "Provision Windows Server licences",
                detail: "The client licenses Windows Server, Standard rather than Datacenter.",
            ),
        ),
        (
            id: "plat-windows",
            source: "platform",
            when: Equals("platform", "windows"),
            consequence: (
                severity: NonDefault,
                status: Advisory,
                audience: Record,
                types: [Operational, Support],
                title: "Windows Server, which is being phased out",
                detail: "Accepted only on strong insistence. The application runs slower on Windows, and support and incident response are slower and less effective than on the Linux platform BES builds and tests against.",
            ),
        ),
        (
            id: "plat-image",
            source: "platform",
            when: Any([
                Equals("platform", "linuxarm"),
                Equals("platform", "linuxamd"),
            ]),
            consequence: (
                status: Requirement,
                audience: Client,
                title: "Install the BES Ubuntu Server image",
                detail: "Linux deployments use the customised [BES Ubuntu Server image](https://github.com/beyondessential/linux-images), set up the BES way.",
            ),
        ),

        // ── Client-hosted server provisioning ───────────────────────────────
        (
            id: "prov-baremetal",
            source: "topology",
            when: Any([
                Equals("onprem_form", "baremetal"),
                Equals("onprem_form", "mixed"),
            ]),
            consequence: (
                status: Requirement,
                audience: Client,
                types: [Operational],
                title: "Provision the physical servers generously up front",
                detail: "Disk and resources are hard to change on bare metal, so provision ahead: at least 500 GB SSD, 4 cores (prefer 8), and 16 GB RAM (prefer 32). Multiple disks and multiple TB are NOT usually required, though you may want to do RAID for redundancy.",
            ),
        ),
        (
            id: "prov-virtualised",
            source: "topology",
            when: Any([
                Equals("onprem_form", "virtualised"),
                Equals("onprem_form", "mixed"),
            ]),
            consequence: (
                status: Advisory,
                audience: Client,
                title: "Start the virtual machines small, and back them up",
                detail: "Resources can scale, so start around 50 GB / 4 cores / 16 GB and grow. VM-level backups are recommended; telling BES is not required but helps disaster planning.",
            ),
        ),
        (
            id: "iti-note",
            source: "topology",
            when: Any([
                Equals("iti_use", "some"),
                Equals("iti_use", "all"),
            ]),
            consequence: (
                status: Requirement,
                audience: Bes,
                title: "Provision and install the Tamanu Iti mini-servers",
                detail: "Tamanu Iti is an ARM64 Linux mini-server, built by BES and provisioned by BES. The client plugs it into their network; BES installs and manages the software.",
            ),
        ),
        (
            id: "central-clienthosted",
            source: "topology",
            when: Equals("central", "clienthosted"),
            consequence: (
                severity: NonDefault,
                status: Advisory,
                audience: Record,
                types: [Operational, Support],
                title: "Client hosts the central server",
                detail: "Hosting Central outside BES cloud puts availability, capacity, and the server's own upkeep on the client's IT team. BES incident response is slower, because BES does not control the platform it runs on.",
            ),
        ),

        // ── Backups ─────────────────────────────────────────────────────────
        (
            id: "block-backup-tupaia",
            source: "backups",
            when: All([
                Equals("backup_capability", "no"),
                Equals("tupaia", "yes"),
            ]),
            consequence: (
                severity: Blocking,
                status: Requirement,
                audience: Record,
                types: [Capability],
                title: "Backups disabled, but dashboards requested",
                detail: "Tupaia needs at least a low-retention backup to process data. With backups fully disabled this cannot work as specified. Permit at least low-retention backups, or drop dashboards and reporting.",
            ),
        ),
        (
            id: "backup-off",
            source: "backups",
            when: Equals("backup_capability", "no"),
            consequence: (
                severity: NonDefault,
                status: Requirement,
                audience: Record,
                types: [Capability, Operational],
                title: "BES backups disabled",
                detail: "Disabling BES backups removes BES-managed recovery and clone-upgrade testing. Without clone upgrades there is significant risk of long or failed upgrades and extended downtime, since deployments typically jump many versions at once.",
            ),
        ),
        (
            id: "low-retention",
            source: "backups",
            when: All([
                Equals("backup_capability", "yes"),
                Equals("retention", "low"),
            ]),
            consequence: (
                severity: NonDefault,
                status: Advisory,
                audience: Record,
                types: [Operational, Capability],
                title: "A few days of backups only",
                detail: "A few days of retention covers feeding dashboards and running upgrade tests, but not recovery. Data lost or corrupted without anyone noticing for a week is gone, because there is no earlier backup to restore from. Full retention keeps a week of daily backups, a month of weekly, and six monthly for exactly that case.",
            ),
        ),

        // ── Upgrades ────────────────────────────────────────────────────────
        (
            id: "cadence",
            source: "upgrades",
            when: Equals("cadence", "lessoften"),
            consequence: (
                severity: NonDefault,
                status: Advisory,
                audience: Record,
                types: [Support, Operational],
                title: "Upgrading less often than support covers",
                detail: "BES supports the last 10 releases. At a release every two weeks that is about five months, so upgrading less often than that means running a version BES no longer supports. It also means jumping many versions at once: heavier migrations, more potential downtime, and stronger reliance on upgrade testing against a copy of the data.",
            ),
        ),

        // ── Networking ──────────────────────────────────────────────────────
        (
            id: "dns-client-acme",
            source: "network",
            when: Equals("dns", "client"),
            consequence: (
                status: Requirement,
                audience: Client,
                title: "Run automatic certificate issuance, and keep domains under one stem",
                detail: "Support automatic ACME certificate issuance, and keep every deployment domain under a common stem (e.g. central.<name>.<tld> and facility.<name>.<tld>, not central.foo.tld alongside facility.bar.tld).",
            ),
        ),
        (
            id: "dns-client",
            source: "network",
            when: Equals("dns", "client"),
            consequence: (
                severity: NonDefault,
                status: Advisory,
                audience: Record,
                types: [Operational],
                title: "DNS and certificates managed by the client",
                detail: "With DNS outside BES's control, certificate renewal depends on the client's own automation. A lapse there takes the deployment offline until the client fixes it, and BES cannot resolve it for them.",
            ),
        ),
        (
            id: "dns-local",
            source: "network",
            when: Equals("dns", "local"),
            consequence: (
                severity: NonDefault,
                status: Advisory,
                audience: Record,
                types: [Operational],
                title: "No DNS: all-local, plain HTTP",
                detail: "With no DNS, servers reach each other over plain HTTP on the local network: no certificates, no TLS, no name-based routing. Supported, but an operational and security risk, because traffic is unencrypted.",
            ),
        ),
        // BES controls DNS; the action depends on how the domain is owned and
        // reaches BES's zone (dns_arrangement). The BES subdomain is the default;
        // the others each add a cost or a client-side step.
        (
            id: "dns-bes-subdomain",
            source: "network",
            when: All([Equals("dns", "bes"), Equals("dns_arrangement", "bes_subdomain")]),
            consequence: (
                status: Advisory,
                audience: Bes,
                title: "Provision the tamanu.app name and its certificates",
                detail: "BES and the client agree on a name under BES's own tamanu.app domain, for example vanuatu.tamanu.app. BES provisions and runs the DNS, and keeps TLS certificates renewed, so there is nothing for client IT to set up.",
            ),
        ),
        (
            id: "dns-bes-topdomain",
            source: "network",
            when: All([Equals("dns", "bes"), Equals("dns_arrangement", "bes_topdomain")]),
            consequence: (
                severity: NonDefault,
                status: Advisory,
                audience: Record,
                types: [Cost],
                title: "DNS: a dedicated BES-owned domain",
                detail: "BES and the client agree on a name for a dedicated top-level domain that BES owns and runs. The domain registration carries a small ongoing cost.",
            ),
        ),
        (
            id: "dns-client-domain-setup",
            source: "network",
            when: All([Equals("dns", "bes"), Equals("dns_arrangement", "client_domain")]),
            consequence: (
                status: Requirement,
                audience: Client,
                title: "Buy the domain and point it at the BES DNS zone",
                detail: "The client purchases the domain, and client IT points it at the DNS zone BES provisions.",
            ),
        ),
        (
            id: "dns-bes-client-domain",
            source: "network",
            when: All([Equals("dns", "bes"), Equals("dns_arrangement", "client_domain")]),
            consequence: (
                severity: NonDefault,
                status: Advisory,
                audience: Record,
                title: "A client-owned domain rather than a name on tamanu.app",
                detail: "BES runs the DNS zone, but the client owns the registration and carries its renewal. Letting it lapse takes the deployment offline.",
            ),
        ),
        (
            id: "dns-client-subdomain-setup",
            source: "network",
            when: All([Equals("dns", "bes"), Equals("dns_arrangement", "client_subdomain")]),
            consequence: (
                status: Requirement,
                audience: Client,
                title: "Delegate a subdomain to the BES DNS zone",
                detail: "Client IT allocates a subdomain on a domain the client already controls and delegates it (SOA records) to the DNS zone BES provisions.",
            ),
        ),
        (
            id: "dns-bes-client-subdomain",
            source: "network",
            when: All([Equals("dns", "bes"), Equals("dns_arrangement", "client_subdomain")]),
            consequence: (
                severity: NonDefault,
                status: Advisory,
                audience: Record,
                title: "A delegated subdomain rather than a name on tamanu.app",
                detail: "The delegation is a setup step on the client side, and the parent domain stays under the client's control, so a change there can break the delegation.",
            ),
        ),
        (
            id: "remote-other",
            source: "network",
            when: Equals("remote", "other"),
            consequence: (
                severity: NonDefault,
                status: Requirement,
                audience: Record,
                types: [Cost, Support],
                title: "Non-Tailscale remote access",
                detail: "Tailscale is what BES supports for reaching managed servers. An exceptional arrangement only, and it may add significant ongoing support cost.",
            ),
        ),
        // Only when the client has servers of their own to configure; with
        // everything in BES cloud, BES handles its own network.
        (
            id: "remote-tailscale",
            source: "network",
            when: All([
                Equals("remote", "tailscale"),
                Any([
                    Equals("central", "clienthosted"),
                    Equals("hosting_where", "allclient"),
                    Equals("hosting_where", "mix"),
                ]),
            ]),
            consequence: (
                status: Requirement,
                audience: Client,
                title: "Allow BES's Tailscale on managed servers",
                detail: "The BES-managed servers join BES's own Tailscale network, not a separate one the client runs. Only those specific servers need Tailscale allowed, not the whole network. Firewalls often block it; [download Tailscale](https://tailscale.com/download) and run its netcheck command on the server or another computer configured similarly to confirm connectivity.",
            ),
        ),
        // Time sync (either source) is a client-network requirement only when
        // the client hosts servers; BES handles its own cloud servers.
        (
            id: "time-internal",
            source: "network",
            when: All([
                Equals("timesync", "internal"),
                Any([
                    Equals("central", "clienthosted"),
                    Equals("hosting_where", "allclient"),
                    Equals("hosting_where", "mix"),
                ]),
            ]),
            consequence: (
                status: Requirement,
                audience: Client,
                title: "Provide the internal time server address",
                detail: "Provide the internal NTP server IP so servers can synchronise time (required for correct function).",
            ),
        ),
        (
            id: "time-outbound",
            source: "network",
            when: All([
                Equals("timesync", "outbound"),
                Any([
                    Equals("central", "clienthosted"),
                    Equals("hosting_where", "allclient"),
                    Equals("hosting_where", "mix"),
                ]),
            ]),
            consequence: (
                status: Requirement,
                audience: Client,
                title: "Allow outbound NTP",
                detail: "Allow outbound NTP to public pools so servers can synchronise time.",
            ),
        ),
        // Time sync is configured for you on the BES-managed Linux servers,
        // but not on Windows, where the client must set it up. Fires for either
        // time source.
        (
            id: "time-windows",
            source: "network",
            when: Equals("platform", "windows"),
            consequence: (
                status: Requirement,
                audience: Client,
                types: [Operational],
                title: "Configure time sync on the Windows servers",
                detail: "On the BES-managed Linux servers time synchronisation is handled for you; on Windows servers the client must configure it explicitly against the chosen time source. Accurate, synchronised time is required; clock drift will break Tamanu.",
            ),
        ),
        (
            id: "dns-partition",
            source: "network",
            when: Any([
                Equals("hosting_where", "allclient"),
                Equals("hosting_where", "mix"),
            ]),
            consequence: (
                status: Advisory,
                audience: Client,
                title: "Make DNS resilient to network partitions",
                detail: "On-site facilities should run a local DNS cache that survives a partition. Non-resilient DNS degrades Tamanu availability during outages.",
            ),
        ),
        (
            id: "egress-ip",
            source: "network",
            when: All([
                Equals("central", "bescloud"),
                Any([
                    Equals("hosting_where", "allclient"),
                    Equals("hosting_where", "mix"),
                ]),
            ]),
            consequence: (
                status: Advisory,
                audience: Client,
                title: "Provide facility egress IP ranges",
                detail: "With Central in BES cloud and on-prem facilities, share the ranges facility traffic comes from so BES can set network restrictions. All communication is facility-initiated, so facility servers need not be publicly reachable.",
            ),
        ),
        // Mobile clients reach Central directly. When BES hosts Central this is
        // handled; when the client hosts it, they must expose it publicly. An
        // unsure mobile count doesn't assert that mobile is in play.
        (
            id: "mobile-public-ip",
            source: "network",
            when: All([
                Answered("mobile"),
                Not(Equals("mobile", "m0")),
                Not(Equals("mobile", "m_unsure")),
                Equals("central", "clienthosted"),
            ]),
            consequence: (
                status: Requirement,
                audience: Client,
                types: [Operational],
                title: "Give Central a public static IP for mobile clients",
                detail: "Mobile clients connect to the central server directly, so when you host Central yourself it needs a public static IP with its HTTPS interface reachable from the internet. (When BES hosts Central, BES provides this.)",
            ),
        ),
        // Any client-hosted presence means the client's network must carry
        // Tamanu's traffic and reach what it needs to install and upgrade.
        (
            id: "onprem-network",
            source: "network",
            when: Any([
                Equals("central", "clienthosted"),
                Equals("hosting_where", "allclient"),
                Equals("hosting_where", "mix"),
            ]),
            consequence: (
                status: Requirement,
                audience: Client,
                types: [Operational],
                title: "Allow Tamanu traffic on the client network",
                detail: "With client-hosted servers, client IT must configure the network to allow Tamanu's application traffic between the Tamanu instances, and the outbound traffic Tamanu needs to install and upgrade. See our [network requirements](https://beyond-essential.slab.com/posts/tamanu-compute-resource-recommendations-network-requirements-and-minimum-specs-wipjcyn1?shr=wipjcyn1#h0uun-network-requirements).",
            ),
        ),

        // ── Pricing and SLA ─────────────────────────────────────────────────
        // What a configuration costs, and what BES can commit to supporting,
        // are decisions for the pricing and partnerships team. They are on the
        // standard path in themselves: a choice being off it is an
        // acknowledgement for the client, while the money and the commitment
        // are work for someone else, so each is its own consequence.
        (
            id: "price-size",
            source: "pricing",
            when: Answered("catchment"),
            consequence: (
                status: Requirement,
                audience: Pricing,
                types: [Cost],
                title: "Price the hosting for the derived size band",
                detail: "The size band is derived from the catchment, the facility count, and the mobile client count, and is the starting point for the hosting cost.",
            ),
        ),
        (
            id: "price-integrations",
            source: "pricing",
            when: Any([
                Includes("integrations", "lims"),
                Includes("integrations", "msupply"),
                Includes("integrations", "rispacs"),
                Includes("integrations", "other_fhir"),
                Includes("integrations", "other_nonfhir"),
            ]),
            consequence: (
                status: Requirement,
                audience: Pricing,
                types: [Cost],
                title: "Price the extra Central capacity for connected systems",
                detail: "Connecting other systems sizes Central up by a flat allowance, regardless of how many are connected.",
            ),
        ),
        (
            id: "price-nonfhir",
            source: "pricing",
            when: Includes("integrations", "other_nonfhir"),
            consequence: (
                status: Requirement,
                audience: Pricing,
                types: [Cost],
                title: "Price the bespoke integration development",
                detail: "A system with no standard health-data interface has to be connected by hand, which is one-off development work rather than configuration.",
            ),
        ),
        (
            id: "price-windows",
            source: "pricing",
            when: Equals("platform", "windows"),
            consequence: (
                status: Requirement,
                audience: Pricing,
                types: [Cost, Support],
                title: "Set the support commitment for a Windows deployment",
                detail: "The client funds the Windows licensing. BES support and incident response are slower on Windows than on Linux, so the commitment BES can make differs from the standard one.",
            ),
        ),
        (
            id: "price-amd64",
            source: "pricing",
            when: Equals("platform", "linuxamd"),
            consequence: (
                status: Requirement,
                audience: Pricing,
                types: [Cost],
                title: "Price the AMD64 hosting premium",
                detail: "AMD64 costs more per unit of capacity than the standard ARM64, and gets less pre-release testing, so incidents take longer to resolve.",
            ),
        ),
        (
            id: "price-remote",
            source: "pricing",
            when: Equals("remote", "other"),
            consequence: (
                status: Requirement,
                audience: Pricing,
                types: [Cost],
                title: "Price the non-Tailscale remote access arrangement",
                detail: "Reaching managed servers by anything other than Tailscale is exceptional, and the ongoing support cost has to be worked out case by case.",
            ),
        ),
        (
            id: "price-domain",
            source: "pricing",
            when: All([Equals("dns", "bes"), Equals("dns_arrangement", "bes_topdomain")]),
            consequence: (
                status: Requirement,
                audience: Pricing,
                types: [Cost],
                title: "Price the dedicated domain registration",
                detail: "A domain BES owns and runs for this deployment carries an ongoing registration cost.",
            ),
        ),
        (
            id: "sla-central",
            source: "pricing",
            when: Equals("central", "clienthosted"),
            consequence: (
                status: Requirement,
                audience: Pricing,
                types: [Support],
                title: "Set the support commitment where the client hosts Central",
                detail: "BES does not control the platform Central runs on, so incident response is slower and availability is partly the client's to keep.",
            ),
        ),
        (
            id: "sla-backups",
            source: "pricing",
            when: Equals("backup_capability", "no"),
            consequence: (
                status: Requirement,
                audience: Pricing,
                types: [Support],
                title: "Set the support commitment without BES backups",
                detail: "With no BES backups there is no managed recovery and no upgrade testing against a copy of the data, so BES cannot commit to recovering the deployment.",
            ),
        ),
        (
            id: "sla-retention",
            source: "pricing",
            when: All([
                Equals("backup_capability", "yes"),
                Equals("retention", "low"),
            ]),
            consequence: (
                status: Requirement,
                audience: Pricing,
                types: [Support],
                title: "Set the recovery commitment for a few days of retention",
                detail: "Recovery only reaches back a few days, so anything discovered later cannot be restored. The commitment has to say so.",
            ),
        ),
        (
            id: "sla-telemetry",
            source: "pricing",
            when: Equals("telemetry", "no"),
            consequence: (
                status: Requirement,
                audience: Pricing,
                types: [Support],
                title: "Set the support commitment without telemetry",
                detail: "Declining telemetry opts the deployment out of BES tech support, managed backups, and mobile support, so there is little left to commit to.",
            ),
        ),
        (
            id: "sla-cadence",
            source: "pricing",
            when: Equals("cadence", "lessoften"),
            consequence: (
                status: Requirement,
                audience: Pricing,
                types: [Support],
                title: "Set the support commitment for upgrades outside the release window",
                detail: "BES supports the last 10 releases. A deployment upgrading less often than that spends time on versions outside the window, which the commitment has to account for.",
            ),
        ),

        // ── Telemetry ───────────────────────────────────────────────────────
        (
            id: "telemetry-off",
            source: "telemetry",
            when: Equals("telemetry", "no"),
            consequence: (
                severity: NonDefault,
                status: Advisory,
                audience: Record,
                types: [Support, Capability],
                title: "No telemetry: support, backups, and mobile are opted out",
                detail: "Declining telemetry opts the deployment out of BES tech support, managed backups, and mobile support. Telemetry carries operational data only, never patient, clinical, or sensitive data.",
            ),
        ),
        // The outbound allowance is a client-network requirement only when the
        // client hosts servers; BES's own cloud servers send telemetry directly.
        (
            id: "telemetry-on",
            source: "telemetry",
            when: All([
                Equals("telemetry", "yes"),
                Any([
                    Equals("central", "clienthosted"),
                    Equals("hosting_where", "allclient"),
                    Equals("hosting_where", "mix"),
                ]),
            ]),
            consequence: (
                status: Requirement,
                audience: Client,
                types: [Operational],
                title: "Allow outbound to BES telemetry",
                detail: "Allow outbound traffic to the BES telemetry endpoints (the DNS names and IPs BES provides) so operational telemetry can be sent.",
            ),
        ),
        // Declining telemetry removes backups and mobile support, which
        // contradicts asking for dashboards (needs backups) or mobile clients.
        (
            id: "block-telemetry-tupaia",
            source: "telemetry",
            when: All([
                Equals("telemetry", "no"),
                Equals("tupaia", "yes"),
            ]),
            consequence: (
                severity: Blocking,
                status: Requirement,
                audience: Record,
                types: [Capability],
                title: "Dashboards requested, but telemetry declined",
                detail: "Declining telemetry opts out of managed backups, but Tupaia needs at least a low-retention backup to process data. This cannot work as specified. Allow telemetry, or drop dashboards and reporting.",
            ),
        ),
        (
            id: "block-telemetry-mobile",
            source: "telemetry",
            when: All([
                Equals("telemetry", "no"),
                Answered("mobile"),
                Not(Equals("mobile", "m0")),
                Not(Equals("mobile", "m_unsure")),
            ]),
            consequence: (
                severity: Blocking,
                status: Requirement,
                audience: Record,
                types: [Capability, Support],
                title: "Mobile clients expected, but telemetry declined",
                detail: "Declining telemetry opts out of mobile support, but mobile clients are expected. This cannot work as specified. Allow telemetry, or remove the mobile clients.",
            ),
        ),
    ],
)
