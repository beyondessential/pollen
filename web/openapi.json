{
  "openapi": "3.1.0",
  "info": {
    "title": "pollen",
    "description": "Public API for the Tamanu deployment onboarding wizard.",
    "contact": {
      "name": "BES Developers",
      "email": "contact@bes.au"
    },
    "license": {
      "name": "GPL-3.0-or-later"
    },
    "version": ""
  },
  "paths": {
    "/api/applications/create": {
      "post": {
        "tags": [
          "applications"
        ],
        "summary": "Create a new draft, binding the bundled default ruleset or a previewed branch.",
        "operationId": "applications_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateArgs"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppView"
                }
              }
            }
          }
        }
      }
    },
    "/api/applications/finalise": {
      "post": {
        "tags": [
          "applications"
        ],
        "summary": "Finalise a draft, freezing it against its bound ruleset. Always produces an\nartifact; the verdict (including a blocking one) is recorded, not enforced.",
        "operationId": "applications_finalise",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FinaliseArgs"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppView"
                }
              }
            }
          },
          "409": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsSchema"
                }
              }
            }
          }
        }
      }
    },
    "/api/applications/fork": {
      "post": {
        "tags": [
          "applications"
        ],
        "summary": "Fork a new draft from any application, with lineage to it. `to_default`\nrebinds to the bundled default; a named branch rebinds to that previewed\nruleset; otherwise the parent's ruleset is kept. Rebinding migrates the\nanswers (stable-id set-diff). The parent is left untouched.",
        "operationId": "applications_fork",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ForkArgs"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppView"
                }
              }
            }
          }
        }
      }
    },
    "/api/applications/get": {
      "post": {
        "tags": [
          "applications"
        ],
        "summary": "Read an application with its current evaluation.",
        "operationId": "applications_get",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GetArgs"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppView"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsSchema"
                }
              }
            }
          }
        }
      }
    },
    "/api/applications/patch": {
      "post": {
        "tags": [
          "applications"
        ],
        "summary": "Replace a draft's answers. Rejected (409) once finalised.",
        "operationId": "applications_patch",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PatchArgs"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AppView"
                }
              }
            }
          },
          "409": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsSchema"
                }
              }
            }
          }
        }
      }
    },
    "/api/meta/version": {
      "post": {
        "tags": [
          "meta"
        ],
        "summary": "Service name and version. Doubles as a trivial reachability check.",
        "operationId": "meta_version",
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VersionInfo"
                }
              }
            }
          }
        }
      }
    },
    "/api/pricing/cost": {
      "post": {
        "tags": [
          "pricing"
        ],
        "summary": "Price inputs set directly (the calculator).",
        "operationId": "pricing_cost",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CostInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CostBreakdown"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsSchema"
                }
              }
            }
          }
        }
      }
    },
    "/api/pricing/model": {
      "post": {
        "tags": [
          "pricing"
        ],
        "summary": "The pricing configuration.",
        "operationId": "pricing_model",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ModelArgs"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PricingModelView"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsSchema"
                }
              }
            }
          }
        }
      }
    },
    "/api/pricing/plan": {
      "post": {
        "tags": [
          "pricing"
        ],
        "summary": "Price a plan from its answers (the priced wizard).",
        "operationId": "pricing_plan",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanArgs"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlanCost"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsSchema"
                }
              }
            }
          }
        }
      }
    },
    "/api/pricing/size": {
      "post": {
        "tags": [
          "pricing"
        ],
        "summary": "Work out the size band, and facility servers, from sizing answers (the\ncalculator's estimator).",
        "operationId": "pricing_size",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SizeArgs"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SizeEstimate"
                }
              }
            }
          },
          "404": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetailsSchema"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AppView": {
        "type": "object",
        "description": "The full state of an application: its lifecycle fields, the questions to\nrender, the current answers, the evaluation (consequences, verdict, derived\nvalues, visible questions, guidance), and, on a fork, what changed.",
        "required": [
          "id",
          "status",
          "created_at",
          "config_hash",
          "update_available",
          "sections",
          "questions",
          "answers",
          "evaluation"
        ],
        "properties": {
          "answers": {},
          "config_hash": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "evaluation": {
            "$ref": "#/components/schemas/Evaluation"
          },
          "finalised_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "migration": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/MigrationView"
              }
            ]
          },
          "parent_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "questions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/QuestionView"
            }
          },
          "sections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Section"
            },
            "description": "The flow's sections, in presentation order."
          },
          "status": {
            "$ref": "#/components/schemas/ApplicationStatus"
          },
          "update_available": {
            "type": "boolean",
            "description": "True when the plan is bound to a ruleset other than the current bundled\ndefault, meaning a newer default is available. A draft updates in place; a\nfinalised plan spawns a new draft on the new ruleset."
          }
        }
      },
      "ApplicationStatus": {
        "type": "string",
        "description": "Whether an artifact is still being edited or has been frozen.",
        "enum": [
          "draft",
          "finalised"
        ]
      },
      "Assumed": {
        "type": "object",
        "description": "A default the engine applied because the question was left unanswered.",
        "required": [
          "question",
          "option"
        ],
        "properties": {
          "option": {
            "type": "string"
          },
          "question": {
            "type": "string"
          }
        }
      },
      "Audience": {
        "type": "string",
        "description": "Which reader a consequence is grouped under in the by-audience view.",
        "enum": [
          "Client",
          "Bes",
          "Pricing",
          "Record"
        ]
      },
      "CloneMode": {
        "type": "string",
        "description": "The clone used to test upgrades.",
        "enum": [
          "off",
          "standard",
          "always_on"
        ]
      },
      "Confidence": {
        "type": "string",
        "description": "How sure the model's owner is of a parameter's value.\nOrdered from most to least certain, so the weakest of several is the maximum.",
        "enum": [
          "Decided",
          "Read",
          "Estimated",
          "Assumed"
        ]
      },
      "Consequence": {
        "type": "object",
        "required": [
          "status",
          "audience",
          "title",
          "detail"
        ],
        "properties": {
          "audience": {
            "$ref": "#/components/schemas/Audience"
          },
          "cost": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Cost"
              }
            ]
          },
          "detail": {
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "title": {
            "type": "string"
          },
          "types": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ConsequenceType"
            }
          }
        }
      },
      "ConsequenceType": {
        "type": "string",
        "description": "The \"this is worse\" axis (spec WIZ, Consequence type).",
        "enum": [
          "Cost",
          "Operational",
          "Capability",
          "Support"
        ]
      },
      "Cost": {
        "type": "object",
        "required": [
          "tier"
        ],
        "properties": {
          "ballpark": {
            "type": [
              "string",
              "null"
            ]
          },
          "tier": {
            "type": "string"
          }
        }
      },
      "CostBreakdown": {
        "type": "object",
        "required": [
          "lines",
          "monthly_usd",
          "annual_usd",
          "display"
        ],
        "properties": {
          "annual_usd": {
            "type": "number",
            "format": "double"
          },
          "display": {
            "$ref": "#/components/schemas/DisplayTotal"
          },
          "lines": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CostLine"
            }
          },
          "monthly_usd": {
            "type": "number",
            "format": "double",
            "description": "The unrounded sum of the lines."
          }
        }
      },
      "CostInput": {
        "type": "object",
        "description": "What a deployment is priced from.",
        "required": [
          "band",
          "central_in_cloud",
          "cloud_facilities",
          "clone",
          "backups",
          "tupaia"
        ],
        "properties": {
          "backups": {
            "type": "boolean"
          },
          "band": {
            "type": "string",
            "description": "A size band named in the pricing configuration."
          },
          "central_in_cloud": {
            "type": "boolean",
            "description": "Whether the central server is in BES cloud. A client-hosted central\nserver costs BES nothing, though its clone still runs in BES cloud."
          },
          "clone": {
            "$ref": "#/components/schemas/CloneMode"
          },
          "clone_uptime": {
            "type": [
              "number",
              "null"
            ],
            "format": "double",
            "description": "How much of the month a standard clone runs, as a fraction. Omitted\ntakes the configured share. Ignored unless the clone is standard."
          },
          "cloud_facilities": {
            "type": "integer",
            "format": "int32",
            "description": "Facility servers in BES cloud.",
            "minimum": 0
          },
          "tupaia": {
            "type": "boolean"
          },
          "windows_central": {
            "type": "boolean",
            "description": "A Windows central server. Applies only while the central is in BES cloud."
          },
          "windows_clone": {
            "type": "boolean"
          },
          "windows_facilities": {
            "type": "integer",
            "format": "int32",
            "description": "How many of the cloud facility servers run Windows (capped at their count).",
            "minimum": 0
          }
        }
      },
      "CostLine": {
        "type": "object",
        "required": [
          "id",
          "label",
          "monthly_usd",
          "confidence"
        ],
        "properties": {
          "confidence": {
            "$ref": "#/components/schemas/Confidence",
            "description": "The weakest confidence among the parameters the line rests on, so a\nfigure made of estimates is not mistaken for a fact."
          },
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "What the line is made of, such as the server and its storage."
          },
          "id": {
            "$ref": "#/components/schemas/LineId"
          },
          "label": {
            "type": "string"
          },
          "monthly_usd": {
            "type": "number",
            "format": "double",
            "description": "Unrounded monthly cost to BES."
          }
        }
      },
      "CreateArgs": {
        "type": "object",
        "properties": {
          "config_branch": {
            "type": [
              "string",
              "null"
            ],
            "description": "A ruleset branch to preview; omitted binds the bundled default."
          }
        }
      },
      "DisplayTotal": {
        "type": "object",
        "description": "The displayed figures: margin and currency applied, then each line rounded\nto the configured step. The monthly figure is the sum of the rounded lines,\nand the annual figure twelve times it, so what is shown adds up.",
        "required": [
          "currency",
          "margin",
          "lines",
          "monthly",
          "annual"
        ],
        "properties": {
          "annual": {
            "type": "number",
            "format": "double"
          },
          "currency": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "number",
              "format": "double"
            },
            "description": "Each line's displayed figure, in the order of the lines."
          },
          "margin": {
            "type": "number",
            "format": "double"
          },
          "monthly": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "EstimatorOption": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "EstimatorQuestion": {
        "type": "object",
        "description": "A sizing question as the estimator offers it.",
        "required": [
          "id",
          "label",
          "options"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EstimatorOption"
            }
          }
        }
      },
      "EstimatorToggle": {
        "type": "object",
        "required": [
          "label",
          "hint"
        ],
        "properties": {
          "hint": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "EstimatorView": {
        "type": "object",
        "description": "The questions the estimator asks, taken from the ruleset.",
        "required": [
          "sizing"
        ],
        "properties": {
          "integrations": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/EstimatorToggle",
                "description": "The yes/no about connected systems."
              }
            ]
          },
          "sizing": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EstimatorQuestion"
            }
          }
        }
      },
      "Evaluation": {
        "type": "object",
        "required": [
          "derived",
          "visible_questions",
          "consequences",
          "requirements",
          "guidance",
          "assumed",
          "open_items",
          "required",
          "verdict"
        ],
        "properties": {
          "assumed": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Assumed"
            },
            "description": "Visible questions left unanswered whose blessed-path default the engine\napplied on the user's behalf (spec WIZ, assumed defaults)."
          },
          "consequences": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TriggeredConsequence"
            },
            "description": "Every triggered consequence, in ruleset order."
          },
          "derived": {
            "type": "object",
            "description": "Derived values keyed by derivation id (e.g. `size` → `Medium`).",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "guidance": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TriggeredGuidance"
            },
            "description": "Guidance whose condition currently holds."
          },
          "open_items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Visible questions the user marked unsure, or left blank where an unsure\noption was available. These make the artifact interim."
          },
          "required": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Visible questions that must be answered: no default to fall back on and\nno unsure option to decline with. These block finalising."
          },
          "requirements": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TriggeredRequirement"
            },
            "description": "The compute requirements for the classes present in the deployment, in\nruleset order (spec WIZ, Compute requirements)."
          },
          "verdict": {
            "$ref": "#/components/schemas/Verdict"
          },
          "visible_questions": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "The ids of questions currently shown, in ruleset order (spec WIZ,\nvisibility). The frontend renders exactly these."
          }
        }
      },
      "FacilityGuess": {
        "type": "object",
        "description": "The guessed cloud facility server count and what it rests on.",
        "required": [
          "count",
          "total",
          "confidence",
          "basis"
        ],
        "properties": {
          "basis": {
            "type": "string"
          },
          "confidence": {
            "$ref": "#/components/schemas/Confidence"
          },
          "count": {
            "type": "integer",
            "format": "int32",
            "description": "Facility servers in BES cloud as answered, before any setting.",
            "minimum": 0
          },
          "total": {
            "type": "integer",
            "format": "int32",
            "description": "All the deployment's facility servers, in BES cloud or not: the most a\nsetting can put in BES cloud.",
            "minimum": 0
          }
        }
      },
      "FinaliseArgs": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "ForkArgs": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "config_branch": {
            "type": [
              "string",
              "null"
            ],
            "description": "A ruleset branch to rebind to; omitted keeps the parent's ruleset."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "to_default": {
            "type": "boolean",
            "description": "Rebind to the current bundled default ruleset (takes precedence over\n`config_branch`). Used to update a stale draft to the latest default."
          }
        }
      },
      "GetArgs": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "LineId": {
        "type": "string",
        "description": "A line of the breakdown. Ids are stable, so tests and the UI can key on them.",
        "enum": [
          "central_box",
          "cloud_facilities",
          "clone",
          "platform_share",
          "backups_db_share",
          "tupaia_reporting",
          "windows_extra"
        ]
      },
      "MigrationView": {
        "type": "object",
        "description": "What a fork's migration changed (spec WIZ, stable-id migration).",
        "required": [
          "dropped",
          "new_questions"
        ],
        "properties": {
          "dropped": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "new_questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ModelArgs": {
        "type": "object"
      },
      "OpenLine": {
        "type": "object",
        "description": "A cost input resting on an answer still open, priced one way for now.",
        "required": [
          "id",
          "label",
          "included",
          "monthly_usd"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/LineId"
          },
          "included": {
            "type": "boolean",
            "description": "Whether the line is in the figure as it stands."
          },
          "label": {
            "type": "string"
          },
          "monthly_usd": {
            "type": "number",
            "format": "double"
          }
        }
      },
      "Opt": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "exclusive": {
            "type": "boolean",
            "description": "In a multi-select, choosing this option clears the others, and choosing\nany other clears this one (e.g. a \"none of these\" choice)."
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "unsure": {
            "type": "boolean",
            "description": "This option means \"I don't know\". Choosing it assumes nothing and\nrecords the question as an open item (spec WIZ, open items)."
          },
          "warn": {
            "type": [
              "string",
              "null"
            ],
            "description": "Shown inline when this option is selected, so the cost of leaving the\nblessed path lands at the point of choice."
          }
        }
      },
      "PatchArgs": {
        "type": "object",
        "required": [
          "id",
          "answers"
        ],
        "properties": {
          "answers": {
            "description": "Answers keyed by question id; each value is an option id or a list of them."
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "PlanArgs": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "overrides": {
            "$ref": "#/components/schemas/PlanOverrides"
          }
        }
      },
      "PlanCost": {
        "type": "object",
        "required": [
          "guess",
          "open",
          "notes"
        ],
        "properties": {
          "cost": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CostBreakdown"
              }
            ]
          },
          "guess": {
            "$ref": "#/components/schemas/FacilityGuess"
          },
          "input": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CostInput",
                "description": "The inputs priced, overrides applied."
              }
            ]
          },
          "missing": {
            "type": [
              "string",
              "null"
            ],
            "description": "Why there is no figure, when there is none."
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "open": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/OpenLine"
            }
          },
          "size": {
            "type": [
              "string",
              "null"
            ],
            "description": "The derived size band, if the plan is sized."
          }
        }
      },
      "PlanOverrides": {
        "type": "object",
        "description": "What the person pricing sets beside the plan. Never stored with it.",
        "properties": {
          "clone": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/CloneMode"
              }
            ]
          },
          "clone_uptime": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "cloud_facilities": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "PricingModelView": {
        "type": "object",
        "description": "The model's configuration, for the calculator's controls.",
        "required": [
          "model",
          "bands",
          "max_cloud_facilities",
          "estimator",
          "facility_guess_by_band",
          "mix_share",
          "facility_slider_question"
        ],
        "properties": {
          "bands": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ServerBox"
            }
          },
          "estimator": {
            "$ref": "#/components/schemas/EstimatorView",
            "description": "The sizing questions the calculator's estimator asks."
          },
          "facility_guess_by_band": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            },
            "description": "For each band, in order, the facility servers if they all run in BES\ncloud."
          },
          "facility_slider_question": {
            "type": "string",
            "description": "The wizard question the cloud facility slider takes the place of."
          },
          "max_cloud_facilities": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "mix_share": {
            "type": "number",
            "format": "double",
            "description": "The share of the facility servers in BES cloud for a mix of both."
          },
          "model": {
            "type": "string"
          }
        }
      },
      "ProblemDetailsSchema": {
        "type": "object",
        "description": "Wire-shape mirror of [`problem_details::ProblemDetails`] for OpenAPI.\n\nEvery error response serializes to this RFC 7807 shape via [`AppError`]'s\n`IntoResponse`. This struct exists so OpenAPI specs can reference a concrete\nschema; nothing constructs values of it at runtime.",
        "required": [
          "type",
          "title",
          "status"
        ],
        "properties": {
          "detail": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable explanation specific to this occurrence."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "description": "HTTP status code generated by the origin server.",
            "example": 404,
            "minimum": 0
          },
          "title": {
            "type": "string",
            "description": "Short human-readable summary of the problem."
          },
          "type": {
            "type": "string",
            "format": "uri",
            "description": "A URI reference identifying the problem type.",
            "example": "/errors/not-found"
          }
        }
      },
      "QuestionKind": {
        "type": "string",
        "enum": [
          "Single",
          "Multi",
          "Band"
        ]
      },
      "QuestionView": {
        "type": "object",
        "description": "A question's render metadata (the engine decides visibility; see\n`Evaluation::visible_questions`).",
        "required": [
          "id",
          "kind",
          "label",
          "options"
        ],
        "properties": {
          "default": {
            "type": [
              "string",
              "null"
            ],
            "description": "The option assumed when this is left blank, if any."
          },
          "help": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/QuestionKind"
          },
          "label": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Opt"
            }
          },
          "section": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Section": {
        "type": "object",
        "description": "A named group of questions, presented together.",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "collapsed": {
            "type": "boolean",
            "description": "Collapsed on arrival, for sections a non-technical user can skip."
          },
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      },
      "ServerBox": {
        "type": "object",
        "description": "One server: its instance, hourly rate, storage, and how many copies of that\nstorage its snapshots hold.",
        "required": [
          "name",
          "instance",
          "usd_per_hour",
          "volume_gb",
          "snapshot_multiple"
        ],
        "properties": {
          "instance": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "snapshot_multiple": {
            "type": "number",
            "format": "double"
          },
          "usd_per_hour": {
            "type": "number",
            "format": "double"
          },
          "volume_gb": {
            "type": "number",
            "format": "double"
          }
        },
        "additionalProperties": false
      },
      "Severity": {
        "type": "string",
        "description": "The viability axis (spec WIZ, Severity).",
        "enum": [
          "Default",
          "NonDefault",
          "Blocking"
        ]
      },
      "SizeArgs": {
        "type": "object",
        "properties": {
          "answers": {
            "type": "object",
            "description": "Option ids keyed by sizing question id. Questions left out are unanswered.",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "type": "string"
            }
          },
          "integrations": {
            "type": "boolean",
            "description": "Whether any other system connects."
          }
        }
      },
      "SizeEstimate": {
        "type": "object",
        "properties": {
          "band": {
            "type": [
              "string",
              "null"
            ],
            "description": "The derived band; none until a sizing question is answered."
          },
          "cloud_facilities": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "Facility servers in BES cloud if they all run there, once the facilities\nquestion is answered.",
            "minimum": 0
          }
        }
      },
      "Spec": {
        "type": "object",
        "description": "One row of a compute requirement as presented: the engine has already\nresolved the size band and dropped the rows whose condition does not hold.",
        "required": [
          "label",
          "value"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "value": {
            "type": "string"
          }
        }
      },
      "Status": {
        "type": "string",
        "description": "The technical-versus-contractual line (spec WIZ, Status).",
        "enum": [
          "Requirement",
          "Advisory",
          "Referral"
        ]
      },
      "TriggeredConsequence": {
        "type": "object",
        "required": [
          "id",
          "source",
          "consequence"
        ],
        "properties": {
          "consequence": {
            "$ref": "#/components/schemas/Consequence"
          },
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          }
        }
      },
      "TriggeredGuidance": {
        "type": "object",
        "required": [
          "at",
          "message"
        ],
        "properties": {
          "at": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "TriggeredRequirement": {
        "type": "object",
        "description": "A compute requirement whose class is present in the deployment. Carries the\nprofile's content (the `when` condition that selected it is not on the wire).",
        "required": [
          "id",
          "class",
          "specs",
          "notes"
        ],
        "properties": {
          "class": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "notes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "specs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Spec"
            }
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Verdict": {
        "type": "string",
        "description": "The viability verdict: the worst severity present across triggered\nconsequences. Default-severity consequences don't move it off `Clear`.",
        "enum": [
          "Clear",
          "NonDefault",
          "Blocking"
        ]
      },
      "VersionInfo": {
        "type": "object",
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "applications",
      "description": "Onboarding artifacts: create, read, edit, finalise, fork."
    },
    {
      "name": "meta",
      "description": "Service metadata."
    },
    {
      "name": "pricing",
      "description": "Internal hosting cost model. Answers only requests naming the configured pricing path."
    }
  ]
}
